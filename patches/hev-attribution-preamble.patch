     HevListNode *(*get_node) (HevSocks5Session *self);
+    /*
+     * Pakomo extension: write a fixed 20-byte attribution preamble carrying the
+     * original connection 5-tuple to the local SOCKS server right after connect
+     * and before the SOCKS5 greeting. Optional; may be NULL.
+     */
+    int (*write_preamble) (HevSocks5Session *self, int fd);
 };
 
