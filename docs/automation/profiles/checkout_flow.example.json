{
  "_comment": "Replace com.example.sut with the installed app under test, place this file at pakomo/profiles/checkout_flow.json, then send start with profile=checkout_flow.",
  "scope": "applications",
  "apps": ["com.example.sut"],
  "domainsByApp": { "com.example.sut": ["api.example.com", "cdn.example.com"] },
  "domains": [],
  "rule": {
    "id": "checkout-medium-reset",
    "name": "Checkout · Medium + Reset",
    "latencyMs": 300,
    "jitterMs": 100,
    "packetLossPercent": 5,
    "downloadKbps": 512,
    "uploadKbps": 128,
    "specialFaults": {
      "CONNECTION_RESET": {
        "enabled": true,
        "resetTiming": "IMMEDIATE",
        "appTargets": {
          "com.example.sut": { "enabled": true, "domains": ["api.example.com"] }
        }
      }
    }
  }
}
